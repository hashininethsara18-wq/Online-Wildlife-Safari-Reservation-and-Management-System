<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | Wildlife Safari</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="d-flex flex-column min-vh-100">

<nav class="navbar navbar-expand-lg navbar-dark bg-success">
  <div class="container">
    <a class="navbar-brand fw-bold" href="/">Wildlife Safari</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="mainNav">
      <ul class="navbar-nav ms-auto">
        <li class="nav-item"><a class="nav-link <%= title === 'Home' ? 'active fw-bold' : '' %>" href="/">Home</a></li>
        <li class="nav-item"><a class="nav-link <%= title === 'Bookings' ? 'active fw-bold' : '' %>" href="/bookings">Bookings</a></li>
        <li class="nav-item"><a class="nav-link <%= title === 'New Booking' ? 'active fw-bold' : '' %>" href="/bookings/new">New Booking</a></li>
      </ul>
    </div>
  </div>
</nav>

<main class="container my-4 flex-grow-1">